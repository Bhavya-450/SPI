`timescale 1ns/1ns

module spi_master_tb;

    wire        sclk, cs, mosi, done, busy;
    wire [7:0]  miso_data;
    reg  [7:0] mosi_data ;
    reg         clk, rst, start, miso;

    spi_master uut (
        .mosi_data  (mosi_data),
        .sclk     (sclk),
        .cs       (cs),
        .mosi     (mosi),
        .done     (done),
        .busy     (busy),
        .miso_data (miso_data),
        .clk      (clk),
        .rst      (rst),
        .start    (start),
        .miso     (miso)
    );

    // Clock generation
    initial clk = 0;
    always #5 clk = ~clk;
  
initial begin 
  $dumpfile("spi_master.vcd");
  $dumpvars(0,spi_master_tb);
end   
      

    initial begin
   $monitor("Time=%0t cs= %b sclk=%b mosi=%b done=%b busy=%b  clk=%b rst=%b start=%b miso=%b miso_data = %b mosi_data =%b ",
                  $time, cs, sclk, mosi, done, busy,clk, rst, start, miso, miso_data, mosi_data);

        rst     = 1;
        start   = 0;
        miso    = 0;
        mosi_data = 8'b10101100;
        #20;
        
        rst = 0;
       
        @(posedge clk);  #1;
        start = 1;
        @(posedge clk);   #1;
        start = 0;

        // Drive miso to feed back in a known RX pattern (sample on sclk falling->rising window)

@(posedge sclk); miso = 0;
@(posedge sclk); miso = 1;
@(posedge sclk); miso = 0;
@(posedge sclk); miso = 1;
@(posedge sclk); miso = 1;
@(posedge sclk); miso = 0;
@(posedge sclk); miso = 0;
@(posedge sclk); miso = 1;

        wait (done == 1);
        #10;

        $finish;
    end
endmodule



