`timescale 1ns/1ns

module SPI_TOP_TB;

    reg clk;
    reg rst;
    reg start;

    reg [7:0] master_tx_data;
    reg [7:0] slave_tx_data;

    wire [7:0] master_rx_data;
    wire [7:0] slave_rx_data;

    wire sclk;
    wire cs;
    wire mosi;
    wire miso;
    wire master_busy;
    wire master_done;
    wire slave_done;

    SPI_TOP uut (
        .clk            (clk),
        .rst            (rst),
        .start          (start),
        .master_tx_data (master_tx_data),
        .slave_tx_data  (slave_tx_data),
        .master_rx_data (master_rx_data),
        .slave_rx_data  (slave_rx_data),
        .sclk           (sclk),
        .cs             (cs),
        .mosi           (mosi),
        .miso           (miso),
        .master_busy    (master_busy),
        .master_done    (master_done),
        .slave_done     (slave_done)
    );

    // 10 ns system-clock period
    initial clk = 1'b0;
    always #5 clk = ~clk;

    initial begin
        $dumpfile("SPI_TOP_TB.vcd");
        $dumpvars(0, SPI_TOP_TB);

        $monitor("T=%0t | CS=%b SCLK=%b MOSI=%b MISO=%b | M_TX=%b M_RX=%b | S_TX=%b S_RX=%b | Busy=%b M_Done=%b S_Done=%b",
                 $time, cs, sclk, mosi, miso,
                 master_tx_data, master_rx_data,
                 slave_tx_data, slave_rx_data,
                 master_busy, master_done, slave_done);

        // Initial/reset values
        rst            = 1'b1;
        start          = 1'b0;
        master_tx_data = 8'b10101100;
        slave_tx_data  = 8'b01011001;

        #20;
        rst = 1'b0;

        // Start one SPI transaction
        @(posedge clk);
        #1 start = 1'b1;

        @(posedge clk);
        #1 start = 1'b0;

        // Wait until master completes the transfer
        @(posedge master_done);

        // Allows slave to detect CS rising edge and assert slave_done
        #20;

        // Master must receive the slave's data
        if (master_rx_data == 8'b01011001)
            $display("MASTER TEST PASSED: master_rx_data = %b", master_rx_data);
        else
            $display("MASTER TEST FAILED: master_rx_data = %b", master_rx_data);

        // Slave must receive the master's data
        if (slave_rx_data == 8'b10101100)
            $display("SLAVE TEST PASSED: slave_rx_data = %b", slave_rx_data);
        else
            $display("SLAVE TEST FAILED: slave_rx_data = %b", slave_rx_data);

        #20;
        $finish;
    end

endmodule 
      
